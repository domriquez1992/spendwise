<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.domriquez</groupId>
    <artifactId>spendwise</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spendwise</name>
    <description>Personal expense tracker REST API</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            Actuator exposes a /actuator/health endpoint that aggregates the health of the
            datasource, MongoDB, and Redis (Spring Boot's built-in indicators). The CI Compose
            smoke test polls it, and it provides the liveness/readiness probe groups.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Observability (Project 10).

            Metrics: the Micrometer Prometheus registry renders all Micrometer meters in the
            Prometheus text format at /actuator/prometheus, which Prometheus scrapes. The version is
            managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Tracing: Spring Boot 4's OpenTelemetry starter (OTLP). Bridges the Micrometer
            Observation API to OpenTelemetry and generates trace/span ids into the logging MDC.
            Traces export only when management.opentelemetry.tracing.export.otlp.endpoint is set (the
            observability overlay points it at Tempo); unset by default and in CI. The starter also
            bundles an OTLP metrics registry, which we disable in application.yml so metrics flow
            only via the Prometheus scrape. All versions are managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            MongoDB stores the append-only audit log as documents. A document store suits an
            ever-growing, write-heavy, loosely-structured event stream better than a relational
            table, while the transactional expense data stays in PostgreSQL (polyglot persistence).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!--
            Redis + Spring Cache: caches the per-user spending summary so the GROUP BY aggregation
            is not recomputed on every read. Boot 4 ships cache auto-configuration in its own
            module, so spring-boot-starter-cache is required alongside the Redis starter for a
            RedisCacheManager to be auto-configured.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!--
            Apache Kafka support: KafkaTemplate (producer) and @KafkaListener (consumer).
            Boot 4 split Kafka auto-configuration into a separate module, so we depend on
            spring-boot-starter-kafka (which pulls in spring-kafka transitively) rather than
            spring-kafka directly. Without the starter, KafkaAutoConfiguration never runs and
            no KafkaTemplate bean is created.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!--
            JSON Web Token support (jjwt). Split into api/impl/serializer modules as the library
            recommends. The Gson serializer is used deliberately instead of jjwt-jackson so that
            JWT (de)serialization is independent of the application's Jackson stack.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-gson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers spins up a real, throwaway Kafka broker in Docker for the
            event-driven integration test, so the produce -> consume flow is verified
            end to end against an actual broker rather than a mock. Versions are managed
            by the Spring Boot parent.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            MongoDB Testcontainer for the audit-log integration test. (Redis uses a core
            GenericContainer with a redis image, so it needs no dedicated module.) Testcontainers 2.x
            renamed the module artifact with a testcontainers- prefix and moved MongoDBContainer to
            the org.testcontainers.mongodb package. Version managed by the Spring Boot parent.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Awaitility: poll for the asynchronously-produced notification without flaky sleeps. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--
                        Generate build-info.properties (version, build time, artifact coordinates)
                        so the Actuator /actuator/info endpoint reports real build metadata.
                    -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
